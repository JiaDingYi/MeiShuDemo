ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/MSMTACustomAdapter" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "${PODS_ROOT}/Ads-CN-Beta/SDK" "${PODS_ROOT}/BaiduMobAdSDK" "${PODS_ROOT}/JADYun" "${PODS_ROOT}/JADYunMotion" "${PODS_ROOT}/KSAdSDK" "${PODS_ROOT}/MSMobAdSDK/MSAdMotion" "${PODS_ROOT}/MSMobAdSDK/MSMobAdSDK" "${PODS_ROOT}/MentaUnifiedSDK" "${PODS_ROOT}/MentaVlionAdapter" "${PODS_ROOT}/MentaVlionBaseSDK" "${PODS_ROOT}/MentaVlionSDK" "${PODS_ROOT}/SigmobAd-iOS/wind-sdk-ios" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN-Beta/BUAdSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN-Beta/CSJMediation" "${PODS_XCFRAMEWORKS_BUILD_DIR}/JADYun" "${PODS_XCFRAMEWORKS_BUILD_DIR}/JADYunMotion" "${PODS_XCFRAMEWORKS_BUILD_DIR}/KSAdSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MSMobAdSDK/MS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MSMobAdSDK/MotionLess" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MentaUnifiedSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MentaVlionAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MentaVlionBaseSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MentaVlionSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/SigmobAd-iOS/WindSDK"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/MSMTACustomAdapter/MSMTACustomAdapter.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/GDTMobSDK" "${PODS_ROOT}/Headers/Public/WechatOpenSDK"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/GDTMobSDK/lib" "${PODS_ROOT}/WechatOpenSDK/OpenSDK1.8.7.1" "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -l"GDTMobSDK" -l"ObjC" -l"WeChatSDK" -l"bz2" -l"c++" -l"c++abi" -l"iconv" -l"resolv" -l"resolv.9" -l"sqlite3" -l"sqlite3.0" -l"xml2" -l"z" -framework "AVFoundation" -framework "AVKit" -framework "Accelerate" -framework "AdSupport" -framework "AssetsLibrary" -framework "AudioToolBox" -framework "AudioToolbox" -framework "BUAdSDK" -framework "BaiduMobAdSDK" -framework "CFNetwork" -framework "CSJMediation" -framework "CoreData" -framework "CoreGraphics" -framework "CoreImage" -framework "CoreLocation" -framework "CoreMedia" -framework "CoreMotion" -framework "CoreServices" -framework "CoreTelephony" -framework "CoreText" -framework "EventKit" -framework "Foundation" -framework "ImageIO" -framework "JADYun" -framework "JADYunMotion" -framework "JavaScriptCore" -framework "KSAdSDK" -framework "MSAdMotion" -framework "MSAdSDK" -framework "MSMTACustomAdapter" -framework "MapKit" -framework "MediaPlayer" -framework "MentaUnifiedSDK" -framework "MentaVlionAdapter" -framework "MentaVlionBaseSDK" -framework "MentaVlionSDK" -framework "MessageUI" -framework "MobileCoreServices" -framework "Photos" -framework "QuartzCore" -framework "QuickLook" -framework "SafariServices" -framework "Security" -framework "SnapKit" -framework "StoreKit" -framework "SystemConfiguration" -framework "UIKit" -framework "WebKit" -framework "WindFoundation" -framework "WindSDK" -weak_framework "AdSupport" -weak_framework "AppTrackingTransparency" -weak_framework "CoreML" -weak_framework "DeviceCheck" -weak_framework "Foundation" -weak_framework "UIKit" -weak_framework "WebKit"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
VALID_ARCHS = armv7 arm64 x86_64
VALID_ARCHS[sdk=iphoneos*] = armv7 arm64
VALID_ARCHS[sdk=iphonesimulator*] = x86_64
